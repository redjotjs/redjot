{
	"name": "redjot",
	"author": "Andrej Kolčin",
	"license": "MPL-2.0",
	"type": "module",
	"private": true,
	"workspaces": [
		"packages/djast/",
		"packages/djast-util-from-djot/",
		"packages/djast-util-to-hast/",
		"packages/redjot-metadata/",
		"packages/redjot-parse/",
		"packages/redjot-rehype/",
		"packages/redjot-typst"
	],
	"scripts": {
		"check": "biome check && tsc --build && npm run test",
		"build": "tsc --build",
		"lint": "biome check --fix --unsafe",
		"doc": "typedoc",
		"test": "npm run build && node --test tests/*",
		"clean": "rm -rf packages/**/dist packages/**/tsconfig.tsbuildinfo tsconfig*.tsbuildinfo target/"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"rehype-stringify": "^10.0.1",
		"typedoc": "^0.28.14",
		"typescript": "^5.9.2",
		"typescript-language-server": "^4.4.0"
	}
}
