{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"strict": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler",

		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,

		"composite": true
	}
}
