{
	"compilerOptions": {
		// Type checking
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Modules
		"module": "esnext",
		"moduleResolution": "bundler", // don't requrie extensions

		// Interop constraints
		"erasableSyntaxOnly": true,
		"isolatedDeclarations": true,
		"isolatedModules": true,

		// Language and environment
		"target": "esnext",

		// Projects
		"composite": true,

		// Completeness
		"skipLibCheck": true
	}
}
