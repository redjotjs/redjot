{
	"files": {
		"includes": [
			"*.json",
			"packages/*/*.json",
			"packages/*/src/**/*.ts",
			"src/**/*.ts"
		]
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"indentWidth": 8,
			"lineWidth": 80,
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentWidth": 8,
			"indentStyle": "tab"
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentWidth": 8,
			"indentStyle": "tab"
		}
	},
	"linter": {
		"rules": {
			"nursery": { "useSortedClasses": "error" },
			"suspicious": { "noUnknownAtRules": "off" }
		}
	}
}
